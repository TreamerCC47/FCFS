{
  "$schema": "https://openapi.vercel.sh/vercel.json",
"rewrites": [
  {
    "source": "/services",
    "destination": "/services/index.html"
  },
  {
    "source": "/services/",
    "destination": "/services/index.html"
  },
  {
  "source": "/faq",
  "destination": "/faq/index.html"
},
{
  "source": "/faq/",
  "destination": "/faq/index.html"
},
{
  "source": "/guides/bookkeeping-south-africa",
  "destination": "/guides/bookkeeping-south-africa/index.html"
},
{
  "source": "/guides/bookkeeping-south-africa/",
  "destination": "/guides/bookkeeping-south-africa/index.html"
},
{
  "source": "/guides/tax-compliance-south-africa",
  "destination": "/guides/tax-compliance-south-africa/index.html"
},
{
  "source": "/guides/tax-compliance-south-africa/",
  "destination": "/guides/tax-compliance-south-africa/index.html"
},
  {
    "source": "/((?!api/).*)",
    "destination": "/index.html"
  }
],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co https://api.whop.com; form-action 'self'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/pay",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}